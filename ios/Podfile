platform :ios, '16.4'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('Flutter', 'Generated.xcconfig'), __dir__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT=(.*)/)
    return matches[1].strip if matches
  end
  raise 'FLUTTER_ROOT not found in Generated.xcconfig. Try deleting Flutter/Generated.xcconfig, then run flutter pub get.'
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # Codec2 (LGPL-2.1) for MeshCore Open TAK voice messages
  pod 'codec2', :path => '../third_party/codec2'
  # ggwave (MIT): share by sound (lib/sound/ggwave_ffi.dart finds it in the process).
  pod 'ggwave', :path => '../third_party/ggwave'
  # AV1 still images (libaom, BSD-2) for photo messages; CI builds libaom
  # into third_party/vox_av1/aom-ios/, otherwise a stub builds.
  pod 'vox_av1', :path => '../third_party/vox_av1'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.4'
    end
  end

  # Dart finds Codec2 and ggwave in the app itself (DynamicLibrary.process() in
  # lib/services/codec2_ffi.dart and lib/sound/ggwave_ffi.dart). No native code
  # calls them, so the linker left both static libraries out of the Runner
  # binary: voice messages and Sound link were missing on iOS. -u makes the
  # linker take each symbol (and keeps it through dead-stripping); stripping
  # only non-global symbols keeps their names for the lookup.
  ffi_symbols = %w[
    codec2_create codec2_destroy codec2_encode codec2_decode
    codec2_samples_per_frame codec2_bytes_per_frame
    ggwave_init ggwave_free ggwave_encode ggwave_ndecode
    ggwave_getDefaultParameters ggwave_setLogFile
  ]
  # Only when libaom is there: the stub has no vox_av1_* to keep. The clip
  # pair is video messages (lib/vox/av1_ffi.dart hasClips): without it the
  # linker drops them, and iPhones had no video.
  if File.exist?(File.join(__dir__, '..', 'third_party', 'vox_av1', 'aom-ios', 'lib', 'libaom.a'))
    ffi_symbols += %w[vox_av1_encode vox_av1_decode vox_av1_clip_encode vox_av1_clip_decode]
  end
  # -u pulls each one out of its static library; -exported_symbol makes it a
  # dead-strip root and keeps it in Runner's export table for dlsym.
  keep = ffi_symbols.map { |s| "-Wl,-u,_#{s} -Wl,-exported_symbol,_#{s}" }.join(' ')
  installer.aggregate_targets.each do |agg|
    agg.user_build_configurations.each_key do |config_name|
      path = agg.xcconfig_path(config_name)
      next unless File.exist?(path)
      xc = File.read(path)
      next if xc.include?('-Wl,-u,_codec2_create')
      unless xc.sub!(/^OTHER_LDFLAGS = \$\(inherited\)/, "OTHER_LDFLAGS = $(inherited) #{keep}")
        xc << "\nOTHER_LDFLAGS = $(inherited) #{keep}\n"
      end
      xc << "\nSTRIP_STYLE = non-global\n"
      File.write(path, xc)
    end
  end
end
